{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sticker",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sticker_id",
    "chapter_id",
    "chapter_title",
    "chapter_slug",
    "category",
    "target_name",
    "rarity",
    "priority",
    "search_hint",
    "status"
  ],
  "properties": {
    "sticker_id": { "type": "string", "minLength": 1 },
    "chapter_id": { "type": "string", "pattern": "^[0-9]{2}$" },
    "chapter_title": { "type": "string", "minLength": 1 },
    "chapter_slug": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "target_name": { "type": "string", "minLength": 1 },
    "rarity": { "type": "string", "minLength": 1 },
    "priority": { "type": "string", "minLength": 1 },
    "search_hint": { "type": "string" },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "query_ready",
        "searching",
        "candidates_found",
        "needs_review",
        "approved",
        "missing",
        "exported"
      ]
    }
  }
}

